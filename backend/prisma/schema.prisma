datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  TRADER
  ADMIN
  MODERATOR
}

enum AssetType {
  STOCK
  CRYPTO
  FOREX
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
  STOP_LOSS
  TAKE_PROFIT
}

enum OrderStatus {
  PENDING
  EXECUTED
  CANCELLED
  EXPIRED
  REJECTED
}

enum OrderEventType {
  CREATED
  EXECUTED
  CANCELLED
  EXPIRED
  REJECTED
}

enum OrderSource {
  MANUAL
  COPY_TRADE
  DCA_BOT
  LEAGUE
}

enum AlertCondition {
  PRICE_ABOVE
  PRICE_BELOW
  PERCENT_CHANGE_UP
  PERCENT_CHANGE_DOWN
}

enum AlertStatus {
  ACTIVE
  TRIGGERED
  EXPIRED
  CANCELLED
}

enum NotificationType {
  ORDER_EXECUTED
  ORDER_CANCELLED
  ORDER_REJECTED
  ORDER_EXPIRED
  PRICE_ALERT
  ACHIEVEMENT_UNLOCKED
  COPY_TRADE_EXECUTED
  LEAGUE_UPDATE
  NEW_FOLLOWER
  SYSTEM
}

// Delivery lifecycle for the notification worker. The row is the in-app
// record; `deliveryStatus` tracks the outbound channels (email/push/socket) so
// a retried BullMQ job cannot send the same notification twice.
enum NotificationDeliveryStatus {
  PENDING
  SENDING
  DELIVERED
  SKIPPED
  FAILED
}

enum LeaderboardScope {
  GLOBAL
  FRIENDS
}

enum LeaderboardPeriod {
  DAILY
  WEEKLY
  MONTHLY
  ALL_TIME
}

enum LeagueStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

// ============================================================
// USER
// ============================================================

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String?
  googleId     String? @unique
  name         String
  avatarUrl    String?

  role Role @default(TRADER)

  isVerified  Boolean @default(false)
  isSuspended Boolean @default(false)

  // Notification preferences
  emailAlerts Boolean @default(true)
  emailDigest Boolean @default(true)
  pushEnabled Boolean @default(false)
  pushToken   String?

  // Relations
  portfolios    Portfolio[]
  refreshTokens RefreshToken[]

  // Social
  following   Follow[]     @relation("UserFollowing")
  followers   Follow[]     @relation("UserFollowers")
  copyTraders CopyTrader[] @relation("Copier")
  copiedBy    CopyTrader[] @relation("Copied")
  posts       Post[]
  postLikes   PostLike[]

  // Engagement
  alerts             Alert[]
  notifications      Notification[]
  leaderboardEntries LeaderboardEntry[]
  sentimentVotes     SentimentVote[]
  userAchievements   UserAchievement[]
  leagueMembers      LeagueMember[]

  // Copy-trade execution audit rows where this user is the copier.
  copyExecutions CopyTradeExecution[] @relation("CopyExecutions")

  // Preferences
  preference UserPreference?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  @@index([role])
}

// ============================================================
// REFRESH TOKENS
// ============================================================

model RefreshToken {
  id String @id @default(uuid())

  token  String @unique
  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  revokedAt DateTime?

  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([userId])
}

// ============================================================
// PORTFOLIO
// ============================================================

model Portfolio {
  id String @id @default(uuid())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String  @default("Main Portfolio")
  description String?

  // Virtual trading money
  startingBalance Decimal @default(10000) @db.Decimal(18, 8)
  cashBalance     Decimal @default(10000) @db.Decimal(18, 8)
  reservedCash    Decimal @default(0) @db.Decimal(18, 8)

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  // Relations
  holdings             Holding[]
  orders               Order[]
  trades               Trade[]
  performanceSnapshots PerformanceSnapshot[]
  leagueMember         LeagueMember?

  // Copy relationships whose copied orders are placed in this portfolio.
  copyTraders CopyTrader[] @relation("CopyDestination")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, isActive])
}

// ============================================================
// HOLDING
// ============================================================

model Holding {
  id String @id @default(uuid())

  portfolioId String

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  symbol    String
  assetType AssetType

  quantity        Decimal @db.Decimal(18, 8)
  averageBuyPrice Decimal @db.Decimal(18, 8)
  totalInvested   Decimal @db.Decimal(18, 8)

  isShort Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([portfolioId, symbol])
  @@index([portfolioId])
  @@index([symbol])
}

// ============================================================
// ORDER
// ============================================================

model Order {
  id String @id @default(uuid())

  portfolioId String

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  symbol    String
  assetType AssetType

  side   OrderSide
  type   OrderType
  status OrderStatus @default(PENDING)

  quantity     Decimal @db.Decimal(18, 8)
  // Cash held for this order while it remains pending.
  reservedCash Decimal @default(0) @db.Decimal(18, 8)

  // Used by LIMIT / STOP / TAKE-PROFIT orders
  limitPrice Decimal? @db.Decimal(18, 8)
  stopPrice  Decimal? @db.Decimal(18, 8)

  // Filled price for executed orders
  executedPrice Decimal? @db.Decimal(18, 8)

  executedAt DateTime?
  expiresAt  DateTime?

  // Worker retry accounting. A transient quote/execution failure increments
  // `executionAttempts`; once it reaches the configured limit the order is
  // rejected so a permanently failing row cannot monopolise the queue.
  executionAttempts      Int       @default(0)
  lastExecutionAttemptAt DateTime?

  notes String?

  source OrderSource  @default(MANUAL)
  trade  Trade?
  events OrderEvent[]

  // Set only for copied orders. The unique constraint makes copied-order
  // creation idempotent even if a fan-out job is replayed after the order
  // committed but before the execution row was updated.
  copyTradeExecutionId String?             @unique
  copyTradeExecution   CopyTradeExecution? @relation(fields: [copyTradeExecutionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([portfolioId])
  @@index([portfolioId, status])
  @@index([status, createdAt])
  @@index([status, expiresAt])
  @@index([symbol, status])
}

// ============================================================
// SYMBOL / MARKET ASSET
// ============================================================

// A tradable instrument (stock, crypto, forex) known to Stox.
//
// `symbol` is the INTERNAL, provider-agnostic Stox identity (e.g. "AAPL",
// "BTCUSDT"). It is deliberately NOT namespaced with a market-data provider
// (no "BINANCE:BTCUSDT"), so the Stox domain never depends on a specific
// provider. Provider-specific tickers and their normalization belong to the
// provider/adapter layer (MarketDataService), not to this model.
model Symbol {
  id        String    @id @default(uuid())
  symbol    String    @unique
  name      String
  assetType AssetType
  exchange  String?
  currency  String    @default("USD")

  // Instrument metadata (populated from provider fundamentals)
  sector      String?
  industry    String?
  logoUrl     String?
  description String?

  // Availability flags: instruments can be hidden/disabled without deletion
  isActive   Boolean @default(true)
  isTradable Boolean @default(true)

  // Relations
  alerts Alert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([symbol])
  @@index([assetType])
}

// Trade
// ============================================================

model Trade {
  id          String @id @default(uuid())
  portfolioId String

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  orderId String @unique

  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  symbol         String
  assetType      AssetType
  side           OrderSide
  quantity       Decimal   @db.Decimal(18, 8)
  price          Decimal   @db.Decimal(18, 8)
  totalValue     Decimal   @db.Decimal(18, 8)
  fees           Decimal   @default(0) @db.Decimal(18, 8)
  realizedPnl    Decimal?  @db.Decimal(18, 8)
  realizedPnlPct Decimal?  @db.Decimal(18, 8)
  executedAt     DateTime  @default(now())

  // Audit rows for follower orders created from this source trade.
  copyExecutions CopyTradeExecution[]

  // Set when the copy-trade fan-out pass has completed for this trade. A
  // periodic scan retries trades whose post-commit enqueue was lost during a
  // Redis outage.
  copyFanOutAt DateTime?

  @@index([portfolioId])
  @@index([symbol])
  @@index([executedAt])
  @@index([portfolioId, executedAt])
  @@index([copyFanOutAt, executedAt])
}

// ============================================================
// ORDER EVENT (AUDIT TRAIL)
// ============================================================

model OrderEvent {
  id String @id @default(uuid())

  orderId String

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Causal, monotonic sequence number per order (1, 2, 3...)
  sequence Int @default(1)

  eventType      OrderEventType
  previousStatus OrderStatus?
  newStatus      OrderStatus

  metadata Json?

  createdAt DateTime @default(now())

  @@unique([orderId, sequence])
  @@index([orderId, createdAt])
}

// ============================================================
// PERFORMANCE SNAPSHOT
// ============================================================

model PerformanceSnapshot {
  id String @id @default(uuid())

  portfolioId String

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  totalValue    Decimal @db.Decimal(18, 8)
  cashBalance   Decimal @db.Decimal(18, 8)
  holdingsValue Decimal @db.Decimal(18, 8)

  dailyPnl    Decimal @db.Decimal(18, 8)
  dailyPnlPct Decimal @db.Decimal(10, 4)

  snapshotDate DateTime @db.Date

  createdAt DateTime @default(now())

  @@unique([portfolioId, snapshotDate])
  @@index([portfolioId])
  @@index([snapshotDate])
}

// ============================================================
// NOTIFICATION
// ============================================================

model Notification {
  id String @id @default(uuid())

  // Stable source-event identity prevents producers from creating duplicate
  // inbox rows when a domain event is replayed. Null is retained for legacy
  // and manually-created notifications.
  eventKey String? @unique

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  message String
  data    Json?

  isRead Boolean   @default(false)
  readAt DateTime?

  deliveryStatus    NotificationDeliveryStatus @default(PENDING)
  deliveredAt       DateTime?
  // Total delivery attempts. Bounds the pending-notification scan so a
  // provider that never recovers cannot be retried forever.
  deliveryAttempts  Int                        @default(0)
  // Set when a worker claims the row. A stale value lets the scan reclaim a
  // row whose worker crashed between the claim and the terminal update.
  deliveryStartedAt DateTime?
  // Per-channel result, e.g. { inApp: true, email: true, push: "skipped" }.
  // Persisted so a retried job resumes without repeating a successful send.
  deliveryChannels  Json?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
  // Pending-delivery scan: WHERE "deliveryStatus" = 'PENDING' ORDER BY "createdAt".
  @@index([deliveryStatus, createdAt])
}

// ============================================================
// FOLLOW
// ============================================================

model Follow {
  id String @id @default(uuid())

  followerId  String
  followingId String

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// ============================================================
// COPY TRADER
// ============================================================

// PostgreSQL CHECK constraints for allocationPct, maxTradeSize, and distinct
// copier/copied users are defined in the CopyTrader migration. Prisma Schema
// Language does not represent these constraints, so keep the migration in sync.
model CopyTrader {
  id String @id @default(uuid())

  copierId String
  copiedId String

  copier User @relation("Copier", fields: [copierId], references: [id], onDelete: Cascade)
  copied User @relation("Copied", fields: [copiedId], references: [id], onDelete: Cascade)

  // Destination portfolio for copied orders. New rows always store the
  // copier's default active portfolio when the API omits an explicit choice.
  // It stays nullable so a deleted portfolio does not erase the relationship;
  // fan-out resolves the default again in that case.
  copyPortfolioId String?
  copyPortfolio   Portfolio? @relation("CopyDestination", fields: [copyPortfolioId], references: [id], onDelete: SetNull)

  allocationPct Decimal  @default(100) @db.Decimal(5, 2)
  maxTradeSize  Decimal? @db.Decimal(18, 8)
  isActive      Boolean  @default(true)

  executions CopyTradeExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([copierId, copiedId])
  @@index([copierId, isActive])
  @@index([copiedId, isActive])
  @@index([copyPortfolioId])
}

// ============================================================
// COPY TRADE EXECUTION
// ============================================================

enum CopyExecutionStatus {
  PENDING
  PLACED
  FAILED
  SKIPPED
}

// One durable row per (source trade, copier). It is the idempotency guard for
// the copy-trade fan-out: a replayed BullMQ job can never place the same
// follower order twice, and it records permanent failures for auditability.
model CopyTradeExecution {
  id String @id @default(uuid())

  sourceTradeId String
  sourceTrade   Trade  @relation(fields: [sourceTradeId], references: [id], onDelete: Cascade)

  copierId String
  copier   User   @relation("CopyExecutions", fields: [copierId], references: [id], onDelete: Cascade)

  copyTraderId String?
  copyTrader   CopyTrader? @relation(fields: [copyTraderId], references: [id], onDelete: SetNull)

  status CopyExecutionStatus @default(PENDING)

  // Bounded retry accounting for transient failures (for example a market
  // data outage while sizing the copied order).
  attempts Int @default(0)

  failureCode    String?
  failureMessage String?

  // Back-relation for Order.copyTradeExecutionId.
  order Order?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceTradeId, copierId])
  @@index([copierId, createdAt])
  @@index([status, createdAt])
  @@index([copyTraderId])
}

// ============================================================
// ALERT
// ============================================================

model Alert {
  id String @id @default(uuid())

  userId   String
  symbolId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol Symbol @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  condition   AlertCondition
  targetPrice Decimal        @db.Decimal(18, 8)
  status      AlertStatus    @default(ACTIVE)

  sendEmail Boolean @default(true)
  sendPush  Boolean @default(false)

  triggeredAt DateTime?
  message     String?

  // Percentage alerts compare the current price against the price at the time
  // the alert was created. `targetPrice` is the percentage threshold for
  // PERCENT_CHANGE_* conditions; for PRICE_ABOVE/PRICE_BELOW it remains the
  // absolute trigger price and these columns stay null.
  baselinePrice Decimal?  @db.Decimal(18, 8)
  baselineAt    DateTime?

  // Rotation cursor for the alert scan. Ordering by this (oldest first) keeps
  // a large alert book fair when one scan cannot cover every symbol.
  lastEvaluatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([status, symbolId])
  @@index([symbolId])
  @@index([status, lastEvaluatedAt])
}

// ============================================================
// LEADERBOARD ENTRY
// ============================================================

model LeaderboardSnapshot {
  id String @id @default(uuid())

  scope  LeaderboardScope
  period LeaderboardPeriod

  snapshotDate DateTime @db.Date

  createdAt DateTime @default(now())

  entries LeaderboardEntry[]

  @@unique([scope, period, snapshotDate])
  @@index([scope, period, snapshotDate])
}

model LeaderboardEntry {
  id String @id @default(uuid())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  scope  LeaderboardScope
  period LeaderboardPeriod

  rank       Int
  totalValue Decimal @db.Decimal(18, 8)
  returnPct  Decimal @db.Decimal(10, 4)

  snapshotDate DateTime @db.Date

  createdAt DateTime @default(now())

  snapshotId String

  snapshot LeaderboardSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([scope, period, snapshotDate, userId])
  @@index([scope, period, snapshotDate, rank])
  @@index([snapshotId])
}

// ============================================================
// POST
// ============================================================

model Post {
  id String @id @default(uuid())

  authorId String

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content  String
  symbol   String?
  metadata Json?

  isHidden Boolean @default(false)

  likes PostLike[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId, createdAt])
  @@index([createdAt])
}

// A user can like each post at most once. Other engagement types are not part
// of the current social API contract.
model PostLike {
  id String @id @default(uuid())

  postId String
  userId String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

// ============================================================
// USER PREFERENCE
// ============================================================

// One-to-one with User: exactly one preferences row per account. The row is
// created lazily on first read (see userPreferenceService) so accounts that
// predate this feature still get defaults.
model UserPreference {
  id String @id @default(cuid())

  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailNotifications Boolean @default(true)
  pushNotifications  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// SENTIMENT
// ============================================================

enum Sentiment {
  BULLISH
  BEARISH
  NEUTRAL
}

model SentimentVote {
  id String @id @default(uuid())

  userId String
  symbol String
  sentiment Sentiment

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, symbol])
  @@index([symbol, updatedAt])
}

// ============================================================
// ACHIEVEMENTS
// ============================================================

model Achievement {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String
  iconUrl     String?
  category    String
  criteria    Json?

  createdAt   DateTime @default(now())

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String
  // Snapshot of the catalog description when this award was granted.
  reason        String

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  unlockedAt DateTime @default(now())

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
}

// ============================================================
// LEAGUES & COMPETITIONS
// ============================================================

model League {
  id              String       @id @default(uuid())
  name            String
  description     String?
  startingBalance Decimal      @default(10000) @db.Decimal(18, 8)
  maxParticipants Int?
  startDate       DateTime
  endDate         DateTime
  status          LeagueStatus @default(UPCOMING)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  members         LeagueMember[]

  @@index([status])
  @@index([startDate, endDate])
}

model LeagueMember {
  id          String    @id @default(uuid())
  leagueId    String
  userId      String
  portfolioId String    @unique

  league      League    @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  rank        Int?
  finalReturn Decimal?  @db.Decimal(18, 8)

  joinedAt    DateTime  @default(now())

  @@unique([leagueId, userId])
  @@index([leagueId])
  @@index([userId])
}

