# ═══════════════════════════════════════════════════════════════
# STOX — Backend Environment Variables
# ═══════════════════════════════════════════════════════════════
# Setup:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in the real values below (.env is gitignored — never commit it)
# ═══════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════
# SERVER
# ═══════════════════════════════════════════════════════════════
PORT=8000
NODE_ENV=development

# ═══════════════════════════════════════════════════════════════
# DATABASE — Supabase Postgres
# Get both URLs from: Supabase Dashboard → Settings → Database → Connection string
#   DATABASE_URL = "Transaction Pooler" string, port 6543 — used by the app at runtime
#   DIRECT_URL   = "Direct connection" string, port 5432   — used by Prisma CLI for migrations
# ═══════════════════════════════════════════════════════════════
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# ═══════════════════════════════════════════════════════════════
# REDIS — install locally: brew install redis && brew services start redis
# ═══════════════════════════════════════════════════════════════
REDIS_URL="redis://localhost:6379"

# ═══════════════════════════════════════════════════════════════
# AUTH — JWT
# Generate your OWN unique values, do not reuse these or share them:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Run twice — access and refresh secrets must be different from each other
# ═══════════════════════════════════════════════════════════════
JWT_ACCESS_SECRET="replace_with_a_long_random_string"
JWT_REFRESH_SECRET="replace_with_a_different_long_random_string"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
BCRYPT_SALT_ROUNDS=10

# ═══════════════════════════════════════════════════════════════
# MARKET DATA APIS
# Finnhub: sign up free at finnhub.io/dashboard for your own API key
# Binance: public market endpoints, no key required
# ═══════════════════════════════════════════════════════════════
FINNHUB_API_KEY="your_finnhub_key_here"
BINANCE_API_URL="https://api.binance.com"

# ═══════════════════════════════════════════════════════════════
# CORS
# ═══════════════════════════════════════════════════════════════
CORS_ORIGIN="http://localhost:3000"

# ═══════════════════════════════════════════════════════════════
# RATE LIMITING
# ═══════════════════════════════════════════════════════════════
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100