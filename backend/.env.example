# ═══════════════════════════════════════════════════════════════
# STOX — Backend Environment Variables
# ═══════════════════════════════════════════════════════════════
# Setup:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in the real values below (.env is gitignored — never commit it)
# ═══════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════
# SERVER
# ═══════════════════════════════════════════════════════════════
PORT=8000
NODE_ENV=development
LOG_LEVEL=info

# ═══════════════════════════════════════════════════════════════
# DATABASE — Supabase Postgres
# Get both URLs from: Supabase Dashboard → Settings → Database → Connection string
#   DATABASE_URL = "Transaction Pooler" string, port 6543 — used by the app at runtime
#   DIRECT_URL   = "Direct connection" string, port 5432   — used by Prisma CLI for migrations
# ═══════════════════════════════════════════════════════════════
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# ═══════════════════════════════════════════════════════════════
# REDIS — install locally: brew install redis && brew services start redis
# ═══════════════════════════════════════════════════════════════
REDIS_URL="redis://localhost:6379"

# CACHE TTL CONFIGURATION (values in seconds)
CACHE_TTL_PRICE_SECONDS=5
CACHE_TTL_PORTFOLIO_SUMMARY_SECONDS=30
CACHE_TTL_LEADERBOARD_SECONDS=60
CACHE_TTL_HISTORICAL_PRICES_SECONDS=3600
CACHE_TTL_SYMBOL_SECONDS=86400
CACHE_TTL_SESSION_SECONDS=604800

# ═══════════════════════════════════════════════════════════════
# REALTIME — Socket.IO + market streaming
# MARKET_STREAM_ENABLED=false selects the polling fallback instead of
# upstream WebSocket streaming. The subscription limits protect the public
# /market namespace from resource exhaustion.
# ═══════════════════════════════════════════════════════════════
MARKET_STREAM_ENABLED=true
MARKET_MAX_SUBSCRIPTIONS_PER_SOCKET=25
MARKET_MAX_TOTAL_SUBSCRIPTIONS=200
MARKET_SUBSCRIPTION_RATE_LIMIT=30
MARKET_SUBSCRIPTION_RATE_WINDOW_MS=10000

# ═══════════════════════════════════════════════════════════════
# AUTH — JWT
# Generate your OWN unique values, do not reuse these or share them:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Run twice — access and refresh secrets must be different from each other
# ═══════════════════════════════════════════════════════════════
JWT_ACCESS_SECRET="replace_with_a_long_random_string"
JWT_REFRESH_SECRET="replace_with_a_different_long_random_string"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
BCRYPT_SALT_ROUNDS=10

# Google Authentication
GOOGLE_CLIENT_ID="your_google_client_id_here"

# ═══════════════════════════════════════════════════════════════
# MARKET DATA APIS
# Finnhub: sign up free at finnhub.io/dashboard for your own API key
# Binance: public market endpoints, no key required
# ═══════════════════════════════════════════════════════════════
FINNHUB_API_KEY="your_finnhub_key_here"
FINNHUB_API_URL="https://finnhub.io/api/v1"
BINANCE_API_URL="https://api.binance.com"
MARKET_DATA_STOCK_PROVIDER=finnhub
MARKET_DATA_CRYPTO_PROVIDER=binance
MARKET_DATA_REQUEST_TIMEOUT_MS=5000

# ═══════════════════════════════════════════════════════════════
# CORS — used by both Express and the Socket.IO handshake.
# CORS_ORIGIN may be a comma-separated list. ALLOWED_ORIGINS is accepted as a
# fallback for existing deployments.
# ═══════════════════════════════════════════════════════════════
CORS_ORIGIN="http://localhost:3000"

# ═══════════════════════════════════════════════════════════════
# RATE LIMITING
# Three tiers: global (per-IP on /api), auth (per-IP on login/register/
# refresh), order (per-USER on order creation). Set RATE_LIMIT_ENABLED=false
# to disable limiting entirely (e.g. local dev or load testing).
# ═══════════════════════════════════════════════════════════════
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_ORDER_WINDOW_MS=60000
RATE_LIMIT_ORDER_MAX=30
